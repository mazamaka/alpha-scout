# Claude AI models
CLAUDE_MODEL_SCREEN=haiku
CLAUDE_MODEL_DEEP=opus

# Scoring weights
SCORE_WEIGHT_ROI=0.4
SCORE_WEIGHT_FEASIBILITY=0.35
SCORE_WEIGHT_COMPLEXITY=0.25
ALERT_SCORE_THRESHOLD=7.0

# Reddit (optional — works without API keys via public JSON)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=alpha-scout/1.0
# REDDIT_SUBREDDITS=["algotrading","polymarket","cryptocurrency","defi","ethfinance"]
REDDIT_INTERVAL_MIN=15

# GitHub (optional, increases rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=
# GITHUB_KEYWORDS=["trading bot","polymarket","defi bot","mev bot","prediction market","crypto arbitrage"]
GITHUB_INTERVAL_MIN=120

# Polymarket
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_VOLUME_SPIKE_PCT=200.0
POLYMARKET_INTERVAL_MIN=15

# Hacker News
# HACKERNEWS_KEYWORDS=["crypto","trading","defi","prediction market","polymarket","arbitrage","MEV","bitcoin","ethereum","trading bot"]
HACKERNEWS_INTERVAL_MIN=60

# RSS feeds
# RSS_FEEDS=["https://www.coindesk.com/arc/outboundfeeds/rss/","https://www.theblock.co/rss.xml"]
RSS_INTERVAL_MIN=60

# Twitter/X (login credentials for twikit)
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=
TWITTER_COOKIES_FILE=data/twitter_cookies.json
# TWITTER_KEYWORDS=["polymarket strategy","prediction market alpha","trading bot","MEV","airdrop strategy","crypto alpha"]
TWITTER_INTERVAL_MIN=30

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=[]

# News Intelligence API (optional, for enriched analysis)
NEWS_INTELLIGENCE_URL=

# Public URL for dashboard links in Telegram messages
SCOUT_URL=http://localhost:8900

# Web dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8900

# Storage directory
DATA_DIR=data
